const express = require("express");
const http = require("http");
const { Server } = require("socket.io");
const path = require("path");

const app = express();
const server = http.createServer(app);
const io = new Server(server);

app.use(express.json());
app.use(express.static(path.join(__dirname, "public")));

app.get("/health", (req, res) => {
  res.json({ status: "YumeChat online 🌸" });
});

io.on("connection", (socket) => {
  console.log("Пользователь подключился:", socket.id);

  socket.on("join", (data) => {
    const room = String(data.room || "general");
    const username = String(data.username || "Гость").slice(0, 24);

    socket.data.username = username;
    socket.join(room);

    socket.to(room).emit("notice", username + " вошёл в чат");
  });

  socket.on("message", (data) => {
    const room = [...socket.rooms].find(r => r !== socket.id);

    if (!room) return;

    const message = {
      username: socket.data.username || "Гость",
      text: String(data.text || "").slice(0, 4000),
      time: new Date().toISOString()
    };

    io.to(room).emit("message", message);
  });

  socket.on("call", (data) => {
    socket.to(data.room).emit("incoming-call", {
      from: socket.id,
      type: data.type
    });
  });

  socket.on("disconnect", () => {
    console.log("Пользователь отключился");
  });
});

const PORT = process.env.PORT || 3000;

server.listen(PORT, () => {
  console.log("YumeChat запущен на порту " + PORT);
});
